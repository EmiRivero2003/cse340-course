<%- include('partials/header') %>

<main>

    <h1><%= project.title %></h1>

    <p><%= project.description %></p>

    <p>
        <strong>Date:</strong>
        <%= new Date(project.date).toLocaleDateString() %>
    </p>

    <p>
        <strong>Location:</strong>
        <%= project.location %>
    </p>

    <p>
        <strong>Organization:</strong>
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>

    <% if (user) { %>

        <section class="volunteer-section">
            <h2>Volunteer</h2>

            <% if (isVolunteering) { %>

                <p>You are volunteering for this project.</p>

                <form action="/project/<%= project.project_id %>/remove-volunteer" method="POST">
                    <button type="submit">
                        Remove Me as Volunteer
                    </button>
                </form>

            <% } else { %>

                <p>Interested in helping with this service project?</p>

                <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                    <button type="submit">
                        Volunteer for This Project
                    </button>
                </form>

            <% } %>
        </section>

    <% } %>

    <% if (user && user.role_name === 'admin') { %>
        <a href="/project/<%= project.project_id %>/assign-categories">
            Edit Categories
        </a>
    <% } %>

    <h2>Categories</h2>

    <% if (categories.length > 0) { %>
        <ul>
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No categories available for this project.</p>
    <% } %>

    <% if (user && user.role_name === 'admin') { %>
        <a href="/edit-project/<%= project.project_id %>">
            Edit Project
        </a>
    <% } %>

</main>

<%- include('partials/footer') %>