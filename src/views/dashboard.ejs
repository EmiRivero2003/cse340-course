<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>

    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>

    <% if (user && user.role_name === 'admin') { %>
        <p>
            <a href="/users">Manage Users</a>
        </p>
    <% } %>

    <section class="dashboard-volunteer-projects">
        <h2>My Volunteer Projects</h2>

        <% if (volunteerProjects && volunteerProjects.length > 0) { %>

            <ul>
                <% volunteerProjects.forEach(project => { %>
                    <li>
                        <h3>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        </h3>

                        <p>
                            <strong>Description:</strong>
                            <%= project.description %>
                        </p>

                        <p>
                            <strong>Date:</strong>
                            <%= new Date(project.date).toLocaleDateString() %>
                        </p>

                        <p>
                            <strong>Location:</strong>
                            <%= project.location %>
                        </p>

                        <p>
                            <strong>Organization:</strong>
                            <a href="/organization/<%= project.organization_id %>">
                                <%= project.organization_name %>
                            </a>
                        </p>

                        <form action="/project/<%= project.project_id %>/remove-volunteer" method="POST">
                            <button type="submit">
                                Remove Me as Volunteer
                            </button>
                        </form>
                    </li>
                <% }) %>
            </ul>

        <% } else { %>

            <p>You have not signed up to volunteer for any projects yet.</p>

        <% } %>
    </section>
</main>

<%- include('partials/footer') %>